<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Mirrors the house-set TFMs of the project under test (dotnet-solution-setup, "Target
         frameworks"; never netstandard2.0, which is not a runtime). Switch to <TargetFrameworks> when
         that set holds more than one TFM. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- v3 test projects are executables; Main is generated by xunit.v3.core. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Coverage: recommended, included by house default; drop it if the project collects no coverage. -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/{{PROJECT}}/{{PROJECT}}.csproj" />
  </ItemGroup>
  <!-- Fixture copy-glob: files the suite loads by relative path next to the test assembly (CSV test
       vectors, PEM keys, raw binary fixtures, expected-output text). Keep only the extensions this
       suite actually loads that way, and drop the rest. -->
  <ItemGroup>
    <None Update="**/*.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.pem">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.key">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="**/*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
